<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Disable compression. E.g. for umbraco backoffice files. These files should be precompressed by node and not let dotnet handle it -->
    <CompressionEnabled>false</CompressionEnabled>
  
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- Views compile at runtime against InMemoryAuto models, so they must not be compiled at build time -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="17.4.2" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" Version="17.4.2" />
    <PackageReference Include="Umbraco.TheStarterKit" Version="17.0.0" />
    <PackageReference Include="uSync" Version="17.3.2" />

    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />

    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dragonfly\Dragonfly.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="bin\" />
  </ItemGroup>
  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
    <UserSecretsId>6225b129-f77e-4cb0-88ac-d9f7a262ad0d</UserSecretsId>
  </PropertyGroup>
  <!--
    Nothing copies the client bundle into this site: the package project ships wwwroot/App_Plugins as
    static web assets, which reach this site through the project reference and are served from there.
    Copying them in as well gives two sources for the same path, which fails the build with
    "Conflicting assets".
  -->
  <Target Name="RemoveCopiedAppPlugins" BeforeTargets="Build" Condition="Exists('$(ProjectDir)wwwroot\App_Plugins\Dragonfly.UfmComponents')">
    <!-- Clears copies left by earlier builds, which would still conflict with the static web assets. -->
    <RemoveDir Directories="$(ProjectDir)wwwroot\App_Plugins\Dragonfly.UfmComponents" />
  </Target>

</Project>
